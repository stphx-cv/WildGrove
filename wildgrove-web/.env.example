# ══════════════════════════════════════════════════════════════════
# wildgrove-web | la tienda pública
#
# Copia este archivo a .env.local y rellena tus propios valores.
# .env.local nunca se sube al repositorio.
#
# Las variables NEXT_PUBLIC_* viajan al navegador y cualquiera puede
# leerlas. No pongas ahí nada que deba quedar oculto.
#
# Guía completa, con de dónde sacar cada credencial:
# docs/06-environment.md
# ══════════════════════════════════════════════════════════════════

# ── Backend (InsForge) ────────────────────────── OBLIGATORIAS ────
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Clave de administración. Se salta las reglas de acceso: solo servidor.
INSFORGE_API_KEY=

# ── Base de datos (Prisma) ────────────────────── OBLIGATORIAS ────
# La que usa la aplicación en funcionamiento. El formato es
# postgresql://usuario:contraseña@servidor:5432/insforge
# El TLS lo decide la propia dirección. Un PostgreSQL recién instalado
# no atiende por TLS, y ahí la dirección va sin parámetros. Contra un
# servidor que sí lo atiende, añade ?sslmode=require al final.
DATABASE_URL=
# La que usan las migraciones. En local puede ser la misma.
DIRECT_URL=

# ── Direcciones de las dos aplicaciones ───────── OBLIGATORIAS ────
# Estos puertos los fija el script `dev` de cada package.json.
# Si cambias uno allí, cámbialo aquí también o los enlaces entre las
# dos aplicaciones apuntarán a donde no hay nada escuchando.
NEXT_PUBLIC_SITE_URL=http://localhost:4680
NEXT_PUBLIC_CMS_URL=http://localhost:8640

# ── Base de datos: ajuste fino ────────────────────── OPCIONALES ──
# Certificado del servidor, si usas TLS con uno propio.
DATABASE_SSL_CA=
# Conexiones simultáneas máximas. Vacío = valor por defecto.
DATABASE_POOL_MAX=
# Milisegundos que aguanta abierta una conexión ociosa.
DATABASE_POOL_IDLE_MS=
# Segundos que vive una conexión antes de que el pool la recicle. Un
# proceso que vive semanas quiere un número más alto que uno que vive
# segundos. Vacío = valor por defecto.
DATABASE_POOL_MAX_LIFETIME_S=

# ── Correo saliente ───────────────────────────────── OPCIONALES ──
# Las cuatro primeras van juntas: si falta una, no sale ningún correo
# y la aplicación arranca igual, sin avisar. Eso deja sin confirmación
# de pedido, sin aviso de reserva y sin recuperar contraseña.
# Los mismos valores tienen que estar en wildgrove-cms/.env.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Esta sí es prescindible: vacía, el remitente es SMTP_USER.
SMTP_FROM=

# ── Proveedor de IA ───────────────────────────────── OPCIONALES ──
# Sin ellas el chat funciona, atendido por el personal desde el panel.
# Sage necesita la clave del proveedor que escribe, elegido en el panel
# con su modelo y su temperatura, y OPENROUTER_API_KEY, que es por donde
# se llama al modelo de decisión aunque el proveedor que escribe sea otro.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Para un endpoint propio compatible con OpenAI.
AI_PROVIDER_API_KEY=
# Segunda vía del modelo de decisión, si OpenRouter falla o tarda.
TYPESAFE_API_KEY=

# ── Google Maps ───────────────────────────────────── OPCIONAL ────
# Va al navegador: restríngela por sitio web y por API en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Upstash Redis ─────────────────────────────────── OPCIONALES ──
# El límite de peticiones. Si las dejas vacías queda APAGADO y la
# aplicación arranca igual, sin avisar. Configúralas si publicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Entre las dos aplicaciones ────────────────────── OPCIONALES ──
# Contraseña compartida para que el panel avise a la tienda de que
# tire su caché. Genérala con: openssl rand -base64 32
# El mismo valor tiene que estar en wildgrove-cms/.env.local
REVALIDATE_SECRET=
