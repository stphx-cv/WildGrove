; Supply-chain policy for this repository. Applies to every clone and to the continuous
; integration builds, which do not see any developer's ~/.npmrc. Rationale:
; wildgrove-vault/reference/07-decisions.md; the rule that applies to every change is in
; wildgrove-vault/rules/02-code-conventions.md.
;
; No dependency lifecycle script runs (preinstall/install/postinstall/prepare). The Prisma client
; is generated explicitly by `turbo run build` (`@wildgrove/db#build`), never at install time.
ignore-scripts=true
; Only install versions published at least 7 days ago. Urgent fix: npm update <pkg> --min-release-age=0
min-release-age=7
; No git dependencies.
allow-git=none
; No remote tarball dependencies either: every package resolves from the registry.
allow-remote=root
