# ══════════════════════════════════════════════════════════════════
# compose.yaml | lo que necesita saber para arrancar las dos apps
#
# Copia este archivo al servidor como .env, al lado de compose.yaml, y rellena
# los valores. Ese archivo no se sube nunca.
#
# Los valores describen la máquina: qué redes existen, qué nombres responden,
# qué etiqueta de imagen está puesta. Por eso viven ahí y no aquí. Ver
# wildgrove-vault/rules/03-never-do.md, punto 2.
# ══════════════════════════════════════════════════════════════════

# ── Qué imagen se arranca ─────────────────────── OBLIGATORIAS ────
# Referencia completa, con etiqueta. La etiqueta es el número de versión del
# proyecto o el commit, así que desde lo que está corriendo se puede llegar
# hasta su documento de versión.
#
# El guion de despliegue escribe la del color que toca por su cuenta; estas dos
# son el valor de partida y lo que se usa si arrancas los servicios a mano.
WEB_IMAGE=
CMS_IMAGE=
# La imagen que aplica las migraciones no se escribe aquí. El guion la saca de
# la imagen de la tienda que despliega: la misma etiqueta, con el nombre
# wildgrove-migrate. Se ejecuta una vez por despliegue de la tienda y se tira.
# El panel no migra nunca.

# ── Nombres públicos ──────────────────────────── OBLIGATORIAS ────
# El dominio que sirve cada app, sin protocolo.
WEB_HOST=
CMS_HOST=

# ── El proxy inverso que ya está delante ──────── OBLIGATORIAS ────
# La red por la que el proxy alcanza a los contenedores.
PROXY_NETWORK=
# El nombre del resolvedor de certificados que el proxy tiene configurado.
# Vacío sirve el nombre por HTTP sin cifrar, y eso solo vale para un nombre de
# pruebas que no existe en el DNS: pedir un certificado para un nombre que no
# resuelve falla, y fallar muchas veces agota el límite de la autoridad.
TRAEFIK_CERT_RESOLVER=
# El punto de entrada que atiende con TLS. Por defecto, websecure.
TRAEFIK_ENTRYPOINT=
# El directorio que el proxy vigila en busca de configuración. El despliegue
# escribe ahí un archivo por app, y reescribirlo es lo que mueve el tráfico sin
# reiniciar nada. Hace falta sudo para escribir ahí.
ROUTING_DIR=

# ── La red del backend ────────────────────────── OBLIGATORIA ─────
# La red interna donde vive la base de datos. Unirse a ella es lo que permite
# que la base deje de aceptar conexiones desde el internet público.
BACKEND_NETWORK=

# ── Los dos archivos de entorno de las apps ───────── OPCIONALES ──
# Dónde están, relativo a compose.yaml. Por defecto .env.web y .env.cms.
WEB_ENV_FILE=
CMS_ENV_FILE=

# ── Ajustes del contenedor ────────────────────────── OPCIONALES ──
# Nombre del conjunto de servicios, y prefijo del nombre de cada contenedor.
# Por defecto, wildgrove, lo que da wildgrove-web-blue y sus tres hermanos.
STACK_NAME=
# Techo de memoria por app. La máquina no tiene memoria de intercambio, así que
# este límite es lo que hace que un exceso mate al contenedor y falle el
# despliegue, en lugar de dejar que el núcleo elija a la base de datos.
# Por defecto, 512m.
APP_MEM_LIMIT=
# Segundos que el color viejo sigue arrancado después del cambio de tráfico,
# para que terminen las peticiones que ya estaban en curso. El guion devuelve
# el control al mover el tráfico y para el color viejo en segundo plano.
# Por defecto, 20.
GRACE_SECONDS=
# Cuántas imágenes conservar por app al limpiar. Por defecto, 2.
KEEP_IMAGES=
