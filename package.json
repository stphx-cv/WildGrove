{
  "name": "wildgrove",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "wildgrove-web",
    "wildgrove-cms",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "turbo run build --filter=@wildgrove/db",
    "db:migrate": "npm run migrate:deploy -w @wildgrove/db",
    "db:seed": "npm run db:seed -w @wildgrove/db",
    "db:studio": "npm run studio -w @wildgrove/db"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "@types/google.maps": "~3.66.3",
    "@hono/node-server": "^1.19.10",
    "lodash": "^4.17.21",
    "postcss": "^8.5.10",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
