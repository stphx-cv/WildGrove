# ══════════════════════════════════════════════════════════════════
# wildgrove-cms | el panel de administración
#
# Copia este archivo a .env.local y rellena tus propios valores.
# .env.local nunca se sube al repositorio.
#
# Esta aplicación usa menos variables que la tienda. Aquí no van las
# claves de IA ni las de Upstash: el chat y el límite de peticiones son
# de la tienda, y el panel le pregunta a la tienda si sus claves de IA
# están puestas. El correo sí, porque el panel responde los tickets de
# soporte.
#
# Guía completa: docs/06-environment.md
# ══════════════════════════════════════════════════════════════════

# ── Backend (InsForge) ────────────────────────── OBLIGATORIAS ────
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# ── Base de datos (Prisma) ────────────────────── OBLIGATORIAS ────
# El TLS lo decide la propia dirección. Un PostgreSQL recién instalado
# no atiende por TLS, y ahí va sin parámetros. Contra un servidor que
# sí lo atiende, añade ?sslmode=require al final.
DATABASE_URL=
DIRECT_URL=

# ── Direcciones de las dos aplicaciones ───────── OBLIGATORIAS ────
NEXT_PUBLIC_SITE_URL=http://localhost:4680
NEXT_PUBLIC_CMS_URL=http://localhost:8640

# ── Base de datos ────────────────────────────── OPCIONALES ──
DATABASE_SSL_CA=
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_MS=
DATABASE_POOL_MAX_LIFETIME_S=

# ── Correo saliente ───────────────────────────────── OPCIONALES ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google Maps ───────────────────────────────────── OPCIONAL ────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Revalidación ──────────────────────────────────── OPCIONAL ────
REVALIDATE_SECRET=

# ── Diagnóstico ───────────────────────────────────── OPCIONAL ────
CMS_SERVER_TIMING=
